+static void VMX_PlanarToNV12(BYTE* ysrc, int ystride, BYTE* usrc, int ustride, BYTE* vsrc, int vstride,
+	BYTE* dstY, int dstStrideY, BYTE* dstUV, int dstStrideUV, VMX_SIZE size)
+{
+	int cw = size.width >> 1;
+	for (int r = 0; r < size.height; r++)
+	{
+		memcpy(dstY + r * dstStrideY, ysrc + r * ystride, size.width);
+	}
+	for (int r = 0; r < size.height; r += 2)
+	{
+		BYTE* u0 = usrc + r * ustride;
+		BYTE* v0 = vsrc + r * vstride;
+		// An odd last row has no partner below it, so it stands alone.
+		BYTE* u1 = (r + 1 < size.height) ? u0 + ustride : u0;
+		BYTE* v1 = (r + 1 < size.height) ? v0 + vstride : v0;
+		BYTE* d = dstUV + (r >> 1) * dstStrideUV;
+		int x = 0;
+#if defined(ARM64)
+		for (; x + 16 <= cw; x += 16)
+		{
+			uint8x16x2_t uv = { { vrhaddq_u8(vld1q_u8(u0 + x), vld1q_u8(u1 + x)),
+				vrhaddq_u8(vld1q_u8(v0 + x), vld1q_u8(v1 + x)) } };
+			vst2q_u8(d + (x << 1), uv);
+		}
+#endif
+		for (; x < cw; x++)
+		{
+			d[x << 1] = (BYTE)((u0[x] + u1[x] + 1) >> 1);
+			d[(x << 1) + 1] = (BYTE)((v0[x] + v1[x] + 1) >> 1);
+		}
+	}
+}
