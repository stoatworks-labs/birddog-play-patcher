#!/bin/bash
# Reverses install:
#
#   ssh -p 9031 root@<play-ip> bash /userdata/bd-stagetimer/uninstall
#
# Stopping the unit first is what gives HDMI back: bdstage restarts BirdDog's
# decoder on SIGTERM, and the unit's ExecStopPost does it if bdstage cannot.
set -u
cd "$(dirname "${BASH_SOURCE[0]}")"
NAME="${BD_MODULE:-$(sed -n 's/^NAME=//p' module.conf | head -1 | tr -d "\"'")}"
DEST="/userdata/bd-${NAME}"
UNIT="bd-${NAME}.service"

systemctl disable --now "$UNIT" 2>/dev/null
# Belt and braces: only if we were the ones holding the display.
if [ -e /run/bdstage-took-display ]; then
  rm -f /run/bdstage-took-display
  systemctl reset-failed BirdDogRunner.service 2>/dev/null
  systemctl start BirdDogRunner.service 2>/dev/null
fi
rm -f "/etc/systemd/system/${UNIT}"
systemctl daemon-reload 2>/dev/null

if [ -x "$DEST/bin/bdstage" ] && grep -q 'bdstage-stagetimer-tab:start' /srv/birddog-web-ui/videoset.html 2>/dev/null; then
  "$DEST/bin/bdstage" --unpatch-ui && systemctl restart BirdDogWebUI 2>/dev/null
fi

cd /
# config.json goes too: it holds the room's API key.
rm -rf "$DEST" /run/bdstage-resume
echo "bd-${NAME} removed; HDMI is back with BirdDog's decoder"
