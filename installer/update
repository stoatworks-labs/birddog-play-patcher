#!/bin/bash
# Custom BirdDog PLAY installer. Run as root by /bin/birddog-update-wrapper
# with cwd set to the extracted package directory.
#
# Design rules (see notes/04):
#   * Everything substantial lives in /userdata. The rootfs gets only a systemd
#     unit, root's authorized_keys, and a probe report.
#   * NOTHING on the recovery path is touched: sshd + sshd_config,
#     birddog-update-wrapper, BirdDogUpdateRunner.service, birddog-web-ui.
#   * Idempotent — safe to install repeatedly.
#   * Never exits non-zero in a way that leaves services stopped.

SDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SDIR" || exit 0

# The stock updater provides this; fall back to echo so we work standalone too.
type birddog-updater-log >/dev/null 2>&1 || birddog-updater-log() { echo "$@"; }

log() { birddog-updater-log "[custom] $*"; echo "[custom] $*" >> /tmp/bd-custom-install.log; }

# shellcheck disable=SC1091
[ -f "$SDIR/build.conf" ] && . "$SDIR/build.conf"
BUILD_TAG="${BUILD_TAG:-unknown}"
WITH_TAILSCALE="${WITH_TAILSCALE:-0}"
WITH_TAILSCALE_UI="${WITH_TAILSCALE_UI:-0}"
WITH_KVM="${WITH_KVM:-0}"
WITH_CAM="${WITH_CAM:-0}"
WITH_CAM_UI="${WITH_CAM_UI:-0}"
WITH_PLAY="${WITH_PLAY:-0}"
DO_REBOOT="${DO_REBOOT:-0}"

log "installer starting, build ${BUILD_TAG}"

# ---------------------------------------------------------------- guard rails
HW_FILE=/etc/birddog-hardware-version
HW="$(cat "$HW_FILE" 2>/dev/null | tr -d '\r\n')"
case "$HW" in
  "BirdDog PLAY"|"BirdDog Pod") log "hardware ID ok: $HW" ;;
  *) log "REFUSING: unexpected hardware ID '${HW}' — this package is PLAY/Pod only"
     exit 0 ;;
esac

# The rootfs is remounted ro on some failure paths; make sure we can write.
if ! touch /etc/.bd-custom-rw-test 2>/dev/null; then
  log "rootfs is read-only, attempting remount rw"
  mount -o remount,rw /dev/root 2>/dev/null || log "WARNING: remount failed"
fi
rm -f /etc/.bd-custom-rw-test 2>/dev/null

mkdir -p /userdata || { log "FATAL: no /userdata"; exit 0; }

FREE_KB=$(df -Pk /userdata 2>/dev/null | awk 'NR==2{print $4}')
log "/userdata free: ${FREE_KB:-unknown} KB"

# ------------------------------------------------------------------- ssh key
if [ -f "$SDIR/authorized_keys" ]; then
  mkdir -p /root/.ssh
  touch /root/.ssh/authorized_keys
  KEY="$(cat "$SDIR/authorized_keys")"
  if grep -qxF "$KEY" /root/.ssh/authorized_keys 2>/dev/null; then
    log "ssh key already present"
  else
    printf '%s\n' "$KEY" >> /root/.ssh/authorized_keys
    log "ssh key installed"
  fi
  # sshd is strict about these; the tar's ownership is not trusted.
  chown -R root:root /root/.ssh
  chmod 700 /root/.ssh
  chmod 600 /root/.ssh/authorized_keys
fi

# ------------------------------------------------------------------ tailscale
if [ "$WITH_TAILSCALE" = 1 ] && [ -d "$SDIR/userdata/tailscale" ]; then
  NEED_KB=$(du -sk "$SDIR/userdata/tailscale" | awk '{print $1}')
  if [ -n "$FREE_KB" ] && [ "$FREE_KB" -lt $((NEED_KB + 51200)) ]; then
    log "SKIPPING tailscale: needs ${NEED_KB} KB + 50 MB headroom, only ${FREE_KB} KB free"
  else
    log "installing tailscale (${NEED_KB} KB)"
    mkdir -p /userdata/tailscale /userdata/tailscale/state
    cp -f "$SDIR/userdata/tailscale/tailscaled" /userdata/tailscale/ 2>/dev/null
    cp -f "$SDIR/userdata/tailscale/tailscale"  /userdata/tailscale/ 2>/dev/null
    chmod 755 /userdata/tailscale/tailscaled /userdata/tailscale/tailscale
    chown root:root /userdata/tailscale/tailscaled /userdata/tailscale/tailscale

    # /dev/net/tun decides whether we get a real interface or userspace mode.
    if [ -c /dev/net/tun ]; then
      TUNARG=""
      log "/dev/net/tun present — full tun mode"
    elif modprobe tun 2>/dev/null && [ -c /dev/net/tun ]; then
      TUNARG=""
      log "/dev/net/tun created via modprobe — full tun mode"
    else
      TUNARG="--tun=userspace-networking --socks5-server=localhost:1055 --outbound-http-proxy-listen=localhost:1055"
      log "no /dev/net/tun — falling back to userspace-networking"
    fi

    cat > /etc/systemd/system/bd-tailscaled.service <<EOF
[Unit]
Description=Tailscale (custom, /userdata)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/userdata/tailscale/tailscaled --state=/userdata/tailscale/state/tailscaled.state --socket=/run/bd-tailscaled.sock ${TUNARG}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
    log "tailscale unit written (tun args: '${TUNARG:-none}')"
    TS_INSTALLED=1
  fi
fi

# --------------------------------------------------- tailscale birdUI panel
# Signing Tailscale in from the web UI instead of over SSH.
#
# This patches /srv/birddog-web-ui/settings.html -- the System page, and NOT
# system-settings.html, which is older markup this firmware does not serve. That
# page also carries the System Update form, so a bad edit takes the firmware
# upload path down with it. The patch itself lives in bdts, where it is unit
# tested against real firmware pages, refuses unfamiliar markup and is exactly
# reversible; the health check and rollback below are the second line.
if [ "${TS_INSTALLED:-0}" = 1 ] && [ "$WITH_TAILSCALE_UI" = 1 ] && [ -f "$SDIR/userdata/bd-tailscale-ui/bdts" ]; then
  log "installing the birdUI Tailscale panel"
  mkdir -p /userdata/bd-tailscale-ui
  cp -f "$SDIR/userdata/bd-tailscale-ui/bdts" /userdata/bd-tailscale-ui/
  chmod 755 /userdata/bd-tailscale-ui/bdts
  chown -R root:root /userdata/bd-tailscale-ui

  # 8092 because 8080 is BirdDog's API, 8090 is bd-cam-api and 8091 is bd-play.
  # A collision is silent: the second service to start fails to bind and its
  # panel simply never answers.
  cat > /etc/systemd/system/bd-tailscale-ui.service <<'EOF'
[Unit]
Description=Tailscale settings panel for birdUI (custom)
After=network.target BirdDogWebUI.service bd-tailscaled.service
Wants=bd-tailscaled.service

[Service]
Type=simple
ExecStart=/userdata/bd-tailscale-ui/bdts --serve :8092
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

  WEBUI_UNIT=BirdDogWebUI
  if ! systemctl cat "$WEBUI_UNIT" >/dev/null 2>&1; then
    log "WARNING: no $WEBUI_UNIT unit on this firmware -- skipping the Tailscale panel"
  elif /userdata/bd-tailscale-ui/bdts --patch-ui --ui-dir /srv/birddog-web-ui --api-port 8092 >> /tmp/bd-custom-install.log 2>&1; then
    PID_BEFORE=$(pidof birddog-web-ui 2>/dev/null | awk '{print $1}')
    log "System page patched; restarting $WEBUI_UNIT (was pid ${PID_BEFORE:-none})"
    systemctl restart "$WEBUI_UNIT" 2>/dev/null
    sleep 5
    PID_AFTER=$(pidof birddog-web-ui 2>/dev/null | awk '{print $1}')
    CODE=$(curl -s -o /dev/null -m 8 -w '%{http_code}' http://127.0.0.1/login 2>/dev/null || echo 000)
    # Same trap as the UVC tab: an unchanged pid means the template was never
    # re-read, so an HTTP 200 is answered by the process that never reloaded.
    if [ -n "$PID_AFTER" ] && [ "$PID_AFTER" != "$PID_BEFORE" ] && { [ "$CODE" = 200 ] || [ "$CODE" = 302 ] || [ "$CODE" = 301 ]; }; then
      log "web UI healthy after patch (pid ${PID_BEFORE:-none} -> $PID_AFTER, HTTP $CODE) -- Tailscale panel is live"
    else
      log "WARNING: web UI unhealthy after patching (pid ${PID_BEFORE:-none} -> ${PID_AFTER:-none}, HTTP $CODE) -- ROLLING BACK"
      /userdata/bd-tailscale-ui/bdts --unpatch-ui --ui-dir /srv/birddog-web-ui >> /tmp/bd-custom-install.log 2>&1
      systemctl restart "$WEBUI_UNIT" 2>/dev/null
      sleep 5
      log "after rollback: HTTP $(curl -s -o /dev/null -m 8 -w '%{http_code}' http://127.0.0.1/login 2>/dev/null || echo 000); stock template also at /srv/birddog-web-ui/settings.html.bdts-stock"
    fi
  else
    log "WARNING: could not patch the System page -- left untouched"
  fi
fi

# ------------------------------------------------------------------ kvm agent
# We install to /userdata/bd-kvm and supervise it ourselves, deliberately NOT
# /userdata/birddog-kvm behind BirdDog's hooks, because:
#   1. Those hooks (birddog-kvm-manager, birddog-kvm-runner, BirdDogKVM.service,
#      99-usb-detect-kvm.rules) are a 1.0.34 feature. VERIFIED ABSENT on a live
#      1.0.30 unit, so relying on them means the agent silently never starts.
#   2. bdup.sh does `rm -rf /userdata/birddog-kvm` on every vendor update, so
#      anything installed there is deleted by the next firmware upgrade.
# Being self-contained fixes both. bdkvm exits 0 when no kbd/mouse is present,
# so Restart=always + RestartSec turns the unit into its own hotplug poller and
# we need no udev rule at all.
if [ "$WITH_KVM" = 1 ] && [ -d "$SDIR/userdata/birddog-kvm" ]; then
  log "installing NDI KVM endpoint to /userdata/bd-kvm"
  mkdir -p /userdata/bd-kvm
  cp -f "$SDIR/userdata/birddog-kvm/bdkvm"  /userdata/bd-kvm/
  cp -f "$SDIR/userdata/birddog-kvm/run.sh" /userdata/bd-kvm/
  chmod 755 /userdata/bd-kvm/bdkvm /userdata/bd-kvm/run.sh
  chown -R root:root /userdata/bd-kvm

  cat > /etc/systemd/system/bd-kvm.service <<'EOF'
[Unit]
Description=BirdDog PLAY NDI KVM endpoint (custom)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/userdata/bd-kvm
ExecStart=/userdata/bd-kvm/run.sh
# bdkvm exits 0 when no input device is attached; restarting on a timer is how
# hotplug is handled without a udev rule.
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
EOF
  log "kvm unit written (self-supervising, no dependency on BirdDog's hooks)"
fi

# ------------------------------------------------------------------ bdcam
# UVC camera -> NDI. Installs alongside bd-kvm and follows the same rules: all
# of it under /userdata, self-supervised, no udev rule (bdcam exits 0 when no
# camera is attached, so Restart=always is the hotplug poller).
#
# It uses the device's own libndi via dlopen — nothing NDI-derived is shipped in
# this package, and the binary works against whichever of libndi.so.5/.6 is
# present.
if [ "$WITH_CAM" = 1 ] && [ -d "$SDIR/userdata/bd-cam" ]; then
  log "installing bdcam (UVC -> NDI) to /userdata/bd-cam"
  mkdir -p /userdata/bd-cam
  cp -f "$SDIR/userdata/bd-cam/bdcam"  /userdata/bd-cam/
  cp -f "$SDIR/userdata/bd-cam/run.sh" /userdata/bd-cam/
  chmod 755 /userdata/bd-cam/bdcam /userdata/bd-cam/run.sh
  chown -R root:root /userdata/bd-cam
  # Preserve an existing config across reinstalls — it is how the device is
  # tuned once it is out of reach.
  if [ ! -f /userdata/bd-cam/bdcam.conf ] && [ -f "$SDIR/userdata/bd-cam/bdcam.conf" ]; then
    cp -f "$SDIR/userdata/bd-cam/bdcam.conf" /userdata/bd-cam/
  fi

  cp -f "$SDIR/userdata/bd-cam/api-run.sh" /userdata/bd-cam/api-run.sh 2>/dev/null
  chmod 755 /userdata/bd-cam/api-run.sh 2>/dev/null

  cat > /etc/systemd/system/bd-cam.service <<'EOF'
[Unit]
Description=BirdDog PLAY UVC camera to NDI (custom)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/userdata/bd-cam
ExecStart=/userdata/bd-cam/run.sh
# HDMI output means taking DRM master from PPApp, so bdcam stops
# BirdDogRunner and restarts it on the way out. That restore cannot run if
# bdcam is killed outright, so put the display back here too -- but ONLY if
# bdcam actually took it. The marker makes that specific: without it this
# would fire on every restart of a disabled service (every 10s below) and
# would fight anyone who stopped BirdDogRunner deliberately.
ExecStopPost=-/bin/sh -c 'if [ -e /run/bdcam-took-display ]; then rm -f /run/bdcam-took-display; systemctl --no-block start BirdDogRunner; fi'
# bdcam exits 0 when no camera is attached; restarting on a timer is how
# hotplug is handled without a udev rule.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
  log "bdcam unit written"

  # The settings API is a separate unit from the streamer deliberately: the
  # streamer exits when no camera is attached, and the settings page has to
  # stay answerable regardless.
  cat > /etc/systemd/system/bd-cam-api.service <<'EOF'
[Unit]
Description=BirdDog PLAY UVC converter settings API (custom)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/userdata/bd-cam
ExecStart=/userdata/bd-cam/api-run.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
  log "bdcam settings API unit written"
fi

# --------------------------------------------------- web UI "UVC Converter" tab
# videoset.html is a Go template parsed by birddog-web-ui AT STARTUP, so a bad
# edit does not bite until the restart below — and if the UI does not come back,
# the firmware upload page goes with it. Hence the health check and automatic
# rollback. The patch itself lives in bdcam, where it is unit tested, refuses
# unfamiliar markup, and is exactly reversible.
if [ "$WITH_CAM_UI" = 1 ] && [ -x /userdata/bd-cam/bdcam ]; then
  # The unit is BirdDogWebUI, NOT "birddog-web-ui" (that is the binary name).
  # Getting this wrong makes the restart a silent no-op and the health check
  # below a false positive, because the old template stays parsed in memory.
  WEBUI_UNIT=BirdDogWebUI
  if ! systemctl cat "$WEBUI_UNIT" >/dev/null 2>&1; then
    log "WARNING: no $WEBUI_UNIT unit on this firmware — skipping the web UI tab"
  elif /userdata/bd-cam/bdcam --patch-ui /srv/birddog-web-ui >> /tmp/bd-custom-install.log 2>&1; then
    PID_BEFORE=$(pidof birddog-web-ui 2>/dev/null | awk '{print $1}')
    log "web UI patched; restarting $WEBUI_UNIT (was pid ${PID_BEFORE:-none})"
    systemctl restart "$WEBUI_UNIT" 2>/dev/null
    sleep 5
    PID_AFTER=$(pidof birddog-web-ui 2>/dev/null | awk '{print $1}')
    CODE=$(curl -s -o /dev/null -m 8 -w '%{http_code}' http://127.0.0.1/login 2>/dev/null || echo 000)
    # It must answer AND be a different process: an unchanged pid means the
    # template was never re-read, so the tab would not actually be there.
    if [ -n "$PID_AFTER" ] && [ "$PID_AFTER" != "$PID_BEFORE" ] && { [ "$CODE" = 200 ] || [ "$CODE" = 302 ] || [ "$CODE" = 301 ]; }; then
      log "web UI healthy after patch (pid ${PID_BEFORE:-none} -> $PID_AFTER, HTTP $CODE) — UVC Converter tab is live"
    else
      log "WARNING: web UI unhealthy after patching (pid ${PID_BEFORE:-none} -> ${PID_AFTER:-none}, HTTP $CODE) — ROLLING BACK"
      /userdata/bd-cam/bdcam --unpatch-ui /srv/birddog-web-ui >> /tmp/bd-custom-install.log 2>&1
      systemctl restart "$WEBUI_UNIT" 2>/dev/null
      sleep 5
      log "after rollback: HTTP $(curl -s -o /dev/null -m 8 -w '%{http_code}' http://127.0.0.1/login 2>/dev/null || echo 000); stock template also at /srv/birddog-web-ui/videoset.html.bdcam-orig"
    fi
  else
    log "WARNING: could not patch the web UI — left untouched"
  fi
fi

# ----------------------------------------------------------------- bdplay
# USB media player. Adds a "USB" entry to birdUI's source dropdown and plays
# video/stills/PDF off a stick, hardware-decoded straight to HDMI.
#
# This is the one payload that touches the rootfs beyond a systemd unit: bdplay
# edits /srv/birddog-web-ui/videoset.html to add the dropdown entry. It keeps a
# pristine copy at videoset.html.bdplay-stock and writes atomically, and
# `bdplay -unpatch-ui` restores it exactly, so the web UI stays recoverable.
#
# bdplay stops BirdDogRunner while it owns the display and restarts it on every
# exit path. TimeoutStopSec gives it room to do that; a SIGKILL here is what
# would leave the unit with a dark HDMI output and PPApp dead.
if [ "$WITH_PLAY" = 1 ] && [ -d "$SDIR/userdata/bd-play" ]; then
  log "installing bdplay (USB media player) to /userdata/bd-play"
  mkdir -p /userdata/bd-play
  cp -f "$SDIR/userdata/bd-play/bdplay" /userdata/bd-play/
  chmod 755 /userdata/bd-play/bdplay
  if [ -f "$SDIR/userdata/bd-play/mutool" ]; then
    cp -f "$SDIR/userdata/bd-play/mutool" /userdata/bd-play/
    chmod 755 /userdata/bd-play/mutool
    log "bdplay: mutool included, PDF playback enabled"
  else
    log "bdplay: no mutool, PDF playback disabled"
  fi
  # exFAT is a FUSE driver, so it needs no kernel module and no image change —
  # /dev/fuse and fuseblk are already present on stock firmware.
  if [ -f "$SDIR/userdata/bd-play/mount.exfat-fuse" ]; then
    cp -f "$SDIR/userdata/bd-play/mount.exfat-fuse" /userdata/bd-play/
    chmod 755 /userdata/bd-play/mount.exfat-fuse
    log "bdplay: exFAT mount helper installed"
  else
    log "bdplay: no exFAT helper — sticks formatted exFAT will not mount"
  fi
  chown -R root:root /userdata/bd-play

  cat > /etc/systemd/system/bd-play.service <<'EOF'
[Unit]
Description=BirdDog PLAY USB media player (custom)
After=network.target BirdDogWebUI.service
# Deliberately NOT After/Requires BirdDogRunner: bdplay stops and starts that
# unit itself when it takes the display, and a dependency would make systemd
# fight it.

[Service]
Type=simple
ExecStart=/userdata/bd-play/bdplay -addr :8091 -state-dir /userdata/bd-play
Restart=always
RestartSec=3
# Room to stop a pipeline and restart BirdDogRunner on the way out.
TimeoutStopSec=30
KillSignal=SIGTERM
Nice=-10

[Install]
WantedBy=multi-user.target
EOF
  log "bdplay unit written"
fi

# -------------------------------------------------------------------- rootfs
if [ -d "$SDIR/files" ]; then
  log "copying rootfs overlay"
  cp -rf "$SDIR/files/." / 2>/dev/null
fi

# --------------------------------------------------------------------- probe
if [ -f "$SDIR/probe.sh" ]; then
  chmod +x "$SDIR/probe.sh"
  "$SDIR/probe.sh" "$BUILD_TAG" || log "probe failed (non-fatal)"
fi

# -------------------------------------------------------------------- enable
systemctl daemon-reload 2>/dev/null
if [ -f /etc/systemd/system/bd-tailscaled.service ]; then
  systemctl enable bd-tailscaled.service 2>/dev/null
  systemctl restart bd-tailscaled.service 2>/dev/null && log "tailscaled started" \
    || log "WARNING: tailscaled failed to start — check 'journalctl -u bd-tailscaled'"
fi
if [ -f /etc/systemd/system/bd-tailscale-ui.service ]; then
  systemctl enable bd-tailscale-ui.service 2>/dev/null
  systemctl restart bd-tailscale-ui.service 2>/dev/null && log "tailscale panel started" \
    || log "WARNING: the tailscale panel failed to start — check 'journalctl -u bd-tailscale-ui'"
fi
if [ -f /etc/systemd/system/bd-kvm.service ]; then
  systemctl enable bd-kvm.service 2>/dev/null
  systemctl restart bd-kvm.service 2>/dev/null && log "bd-kvm started" \
    || log "WARNING: bd-kvm failed to start — check 'journalctl -u bd-kvm'"
fi
if [ -f /etc/systemd/system/bd-cam.service ]; then
  systemctl enable bd-cam.service 2>/dev/null
  systemctl restart bd-cam.service 2>/dev/null && log "bd-cam started" \
    || log "WARNING: bd-cam failed to start — check 'journalctl -u bd-cam'"
fi
if [ -f /etc/systemd/system/bd-play.service ]; then
  systemctl enable bd-play.service 2>/dev/null
  systemctl restart bd-play.service 2>/dev/null && log "bd-play started" \
    || log "WARNING: bd-play failed to start — check 'journalctl -u bd-play'"
fi
if [ -f /etc/systemd/system/bd-cam-api.service ]; then
  systemctl enable bd-cam-api.service 2>/dev/null
  systemctl restart bd-cam-api.service 2>/dev/null && log "bd-cam-api started on :8090" \
    || log "WARNING: bd-cam-api failed to start — check 'journalctl -u bd-cam-api'"
fi

# --------------------------------------------------- restore stock services
# /bin/birddog-update-wrapper does `systemctl stop BirdDogRunner` before calling
# us, and only ever reboots via bdup.sh. We are not bdup.sh, so if we exit
# without either rebooting or restarting it, the unit is left with PPApp dead:
# no video, no OSD, just a dark HDMI output. Looks bricked; isn't.
if [ "$DO_REBOOT" != 1 ]; then
  if systemctl is-active --quiet BirdDogRunner 2>/dev/null; then
    log "BirdDogRunner already running"
  else
    systemctl start BirdDogRunner 2>/dev/null \
      && log "BirdDogRunner restarted (the wrapper had stopped it)" \
      || log "WARNING: could not restart BirdDogRunner — reboot the unit"
  fi
fi

sync; sync
log "installer finished (build ${BUILD_TAG})"
log "probe report: http://<this-device>/static/bd-probe.txt"
if [ "${TS_INSTALLED:-0}" = 1 ]; then
  if [ -f /etc/systemd/system/bd-tailscale-ui.service ]; then
    log "tailscale is installed but NOT authenticated — sign in from the System page of the"
    log "web UI, or ssh in on port 9031 and run:"
  else
    log "tailscale is installed but NOT authenticated — ssh in on port 9031 and run:"
  fi
  log "  /userdata/tailscale/tailscale --socket=/run/bd-tailscaled.sock up"
fi

if [ "$DO_REBOOT" = 1 ]; then
  log "rebooting"
  /bin/birddog-reboot-request 2>/dev/null || reboot
fi

exit 0
